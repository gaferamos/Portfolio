@inject IJSRuntime JS

<div class="menu">
    <div class="container buton" @onclick="ToggleInfo" @onclick:preventDefault style="cursor:pointer;"></div>


    <div class="menucontent @(showInfo ? "open" : "")">
        <div class="navlist">
            <ul>
                <li><a  href="/">home</a></li>
                <li><a  href="/personalprojects">projetos pessoais</a></li>
                <li><a  href="/groupprojects">projetos em grupo</a></li>
                <li><a  href="/studyprojects">projetos de estudo</a></li>
                
            </ul>
        </div>

        <div class="centerinfo">
            <h1>home</h1>
        </div>

        <div class="bottoninfo">
            <ul>
                <li><a href="javascript:void(0)" @onclick:preventDefault>contato</a></li>
                <li><a href="javascript:void(0)" @onclick:preventDefault>mail</a></li>
            </ul>
        </div>
    </div>
</div>


@code {
    private bool showInfo = false;

    private async Task ToggleInfo()
    {
        showInfo = !showInfo;

        if (showInfo)
        {
            await JS.InvokeVoidAsync("toggleBodyScroll.add");
        }
        else
        {
            await JS.InvokeVoidAsync("toggleBodyScroll.remove");
        }
    }
}
