<div id="cards" class="cardinfo">

    <div class="card card1 " style="width: 18rem;">
        <img src="images/studyprj.jpg" class="card-img-top" alt="...">
        <div class="card-body card-body d-flex flex-column">
            <h5 class="card-title">Projetos de Estudo</h5>

            <p class="card-text">@ProjectCardInfo</p>
            <a href="/studyprojects" class="btn btn-dark mt-auto">Explorar</a>
        </div>
    </div>

     <div class="card card2" style="width: 18rem;">
        <img src="images/personalprj.jpg" class="card-img-top" alt="...">
        <div class="card-body card-body d-flex flex-column">
            <h5 class="card-title">Projetos Pessoais</h5>

            <p class="card-text">@Personalprjcardinfo</p>
            <a href="/personalprojects" class="btn btn-dark mt-auto">Explorar</a>
        </div>
    </div>

    <div class="card card3" style="width: 18rem;">
        <img src="images/groupwrk.jpg" class="card-img-top" alt="...">
        <div class="card-body card-body d-flex flex-column">
            <h5 class="card-title">Projetos Em Grupo</h5>

            <p class="card-text">@Groupprjrcardinfo</p>
            <a href="/groupprojects" class="btn btn-dark mt-auto">Explorar</a>
        </div>
    </div> 

</div>

@code {
    private string ProjectCardInfo = "Projetos desenvolvidos para explorar novas técnicas e expandir conhecimentos.";

    private string Personalprjcardinfo = "Projetos pessoais desenvolvidos para transformar ideias em código e compartilhá-las com o mundo.";

    private string Groupprjrcardinfo = "Projetos colaborativos desenvolvidos para alcançar grandes resultados juntos.";

    private string fullText = "Olá, eu sou o Gabriel\n Bem Vindo";
    private string displayedText = "";
    private int index = 0;
    private string cusorChar = "_";

    private string fullText2 = "Olá, sou o Gabriel.\nSou estudante de Ciências da Computação.\nAqui te apresento um pouco sobre mim e meus projetos\n>";
    private string displayedText2 = "";
    private int index2 = 0;
    private string cusorChar2 = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        
        while (index < fullText.Length)
        {
            displayedText += fullText[index];
            index++;
            StateHasChanged();
            await Task.Delay(100); // velocidade de digitação (100ms por letra)
        }
        cusorChar = string.Empty;
        cusorChar2 = "_";
        while (index2 < fullText2.Length)
        {
            displayedText2 += fullText2[index2];
            index2++;
            StateHasChanged();
            await Task.Delay(50); // velocidade de digitação (100ms por letra)
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("imageFadeInit");
        }
    }
}