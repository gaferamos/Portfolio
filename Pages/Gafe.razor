@code {
    private string ProjectCardInfo = "Projetos desenvolvidos para explorar novas técnicas e expandir conhecimentos.";

    private string Personalprjcardinfo = "Projetos pessoais desenvolvidos para transformar ideias em código e compartilhá-las com o mundo.";

    private string Groupprjrcardinfo = "Projetos colaborativos desenvolvidos para alcançar grandes resultados juntos.";

    private string fullText = "Bem Vindo";
    private string displayedText = "";
    private int index = 0;
    private string cusorChar = "_";

    private string fullText2 = "Sou o Gabriel.\nEstudante de Ciências da Computação.\nAqui te apresento um pouco sobre mim e meus projetos\n>";
    private string displayedText2 = "";
    private int index2 = 0;
    private string cusorChar2 = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        
        while (index < fullText.Length)
        {
            displayedText += fullText[index];
            index++;
            StateHasChanged();
            await Task.Delay(100); // velocidade de digitação (100ms por letra)
        }
        cusorChar = string.Empty;
        cusorChar2 = "_";
        while (index2 < fullText2.Length)
        {
            displayedText2 += fullText2[index2];
            index2++;
            StateHasChanged();
            await Task.Delay(50); // velocidade de digitação (100ms por letra)
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("imageFadeInit");
        }
    }
}